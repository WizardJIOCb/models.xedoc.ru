{
  "name": "models-xedoc-ru",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @models/server --filter @models/web dev",
    "dev:server": "pnpm --filter @models/server dev",
    "dev:web": "pnpm --filter @models/web dev",
    "dev:worker": "pnpm --filter @models/worker dev",
    "start:server": "pnpm --filter @models/server start",
    "start:worker": "pnpm --filter @models/worker start"
  }
}
